# Copia este archivo como .env y completa los valores. .env NO se sube a Git.
ENVIRONMENT=dev

# --- PostgreSQL ---
# Local (docker compose):  PG_HOST=localhost  PG_USER=postgres  PG_PASSWORD=postgres
# Base de la clase:        PG_HOST=mgg.vps.webdock.cloud  PG_USER=usr_ro_dmc_rrhh_estudiantes
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=dmc
PG_SCHEMA=rrhh
PG_TABLE=empleado
PG_USER=postgres
PG_PASSWORD=postgres

# --- Almacenamiento ---
# blob  = Azure Blob / Azurite (si no defines la cadena, se usa Azurite en 127.0.0.1:10000)
# local = carpeta ./datalake (sin Docker)
STORAGE_MODE=blob
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
RAW_CONTAINER=raw
CURATED_CONTAINER=curated
CSV_BLOB_NAME=comisiones/ComisionEmpleados_V1_202610.csv

# inner = solo empleados con comisión | left = todos los empleados (comisión 0 si no tiene)
JOIN_TYPE=inner
